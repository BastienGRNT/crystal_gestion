# Port HTTP de l'app (le même à l'intérieur et à l'extérieur du conteneur)
PORT=3000

# URL publique, sans / final (obligatoire derrière un domaine : formulaires, cookies Secure)
ORIGIN=http://localhost:3000

# Utilisateur PostgreSQL (créé au premier démarrage de la base)
POSTGRES_USER=crystal

# Mot de passe PostgreSQL (fixé au premier démarrage : le changer ensuite ne change pas celui de la base)
POSTGRES_PASSWORD=changeme

# Nom de la base PostgreSQL
POSTGRES_DB=crystal

# Connexion à PostgreSQL : l'hôte « db » est le service du compose de production.
# En dev local (npm run db:start) : postgres://crystal:crystal@localhost:55432/crystal
DATABASE_URL=postgres://crystal:changeme@db:5432/crystal

# Clé qui chiffre les mots de passe du coffre (openssl rand -base64 32). Ne plus la changer une fois le coffre rempli.
APP_SECRET=changeme

# Taille maximale d'un envoi de fichier
BODY_SIZE_LIMIT=200M

# Derrière le reverse proxy HTTPS : en-tête qui donne le protocole d'origine (si ORIGIN est vide)
PROTOCOL_HEADER=x-forwarded-proto

# Derrière le reverse proxy HTTPS : en-tête qui donne l'adresse IP du visiteur
ADDRESS_HEADER=X-Forwarded-For

# Nombre de proxys de confiance devant l'app (Nginx Proxy Manager)
XFF_DEPTH=1
