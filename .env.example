DATABASE_URL="postgres://crystal:crystal@localhost:55432/crystal"
# Où les fichiers envoyés sont rangés sur le disque
STORAGE_DIR="./data/storage"
# Clé qui chiffre les mots de passe du coffre (openssl rand -base64 32). Ne la change plus une fois le coffre rempli.
APP_SECRET=""
# Taille maximale d'un envoi en production (adapter-node)
BODY_SIZE_LIMIT="200M"
# URL publique en production (obligatoire derrière un domaine, sinon les formulaires sont refusés)
